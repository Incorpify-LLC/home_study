{
	"name": "home-study",
	"version": "0.1.0",
	"private": true,
	"description": "A private, adaptive family study platform on Cloudflare Workers.",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"audit:public-data": "node scripts/check-public-data.mjs",
		"audit:questions": "vitest run test/question-quality.spec.ts",
		"audit:secrets": "bash scripts/scan-secrets.sh",
		"audit:security": "npm audit --audit-level=moderate && npm run audit:public-data && npm run audit:secrets",
		"build": "wrangler deploy --dry-run --outdir .wrangler-dist",
		"cf-typegen": "wrangler types",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm run test:run && npm run audit:public-data && npm run build",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"start": "wrangler dev",
		"test": "vitest",
		"test:run": "vitest run",
		"test:remote": "node scripts/remote-smoke.mjs",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"prettier": "^3.9.10",
		"typescript": "^5.5.2",
		"typescript-eslint": "^8.71.2",
		"vitest": "^4.1.12",
		"wrangler": "^4.151.2"
	}
}
